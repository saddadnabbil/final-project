# ============================================
# BACKEND CONFIGURATION
# ============================================
# Copy this file to .env and adjust as needed
# For M1/M2 Mac, use the M1 OPTIMIZED settings below

# ============================================
# 1. FLASK & AUTHENTICATION
# ============================================
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_EXPIRATION_DAYS=7

# CORS - Add your frontend domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URI=sqlite:///translator.db

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# 2. WHISPER MODEL SELECTION
# ============================================
# Available models:
#   whisper-base-1500steps    = Fine-tuned 1500 steps (~1GB VRAM)
#   whisper-base-4500steps    = Fine-tuned 4500 steps (~1GB VRAM)
#   whisper-small-openslr     = Kaggle trained (WER ~7%, ~2GB VRAM)
#   whisper-medium-sundanese  = HuggingFace trained (WER 3.66%, ~5GB VRAM) [RECOMMENDED]
#   google-speech-api         = Google Cloud Speech API (online, no GPU)

WHISPER_MODEL_VARIANT=whisper-medium-sundanese

# Base Whisper model type (tiny, base, small, medium, large-v3)
WHISPER_MODEL_TYPE=base

# Custom model path (leave empty for auto)
WHISPER_MODEL_PATH=

# Fine-tuned model settings
USE_FINETUNED_WHISPER=false
FINETUNED_WHISPER_PATH=./models/whisper-cp1000

# ============================================
# 3. TRANSLATION MODEL (NLLB)
# ============================================
# Options:
#   facebook/nllb-200-distilled-600M  = Smaller, faster (~2GB RAM)
#   facebook/nllb-200-1.3B            = Larger, better quality (~5GB RAM)

NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M

# ============================================
# 4. DEVICE & GPU SETTINGS
# ============================================
# Device options: cuda, cpu, mps (Apple Silicon), auto

# --- FOR NVIDIA GPU (Windows/Linux) ---
# WHISPER_DEVICE=cuda
# NLLB_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# ENABLE_GPU_ACCELERATION=true
# FP16_PRECISION=true

# --- FOR M1/M2 MAC (RECOMMENDED) ---
WHISPER_DEVICE=cpu
NLLB_DEVICE=cpu
WHISPER_COMPUTE_TYPE=float32
ENABLE_GPU_ACCELERATION=false
FP16_PRECISION=false

# --- FOR CPU ONLY ---
# WHISPER_DEVICE=cpu
# NLLB_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=float32
# ENABLE_GPU_ACCELERATION=false
# FP16_PRECISION=false

# ============================================
# 5. BACKEND PROCESSING MODE
# ============================================
# USE_OPTIMIZED_BACKEND: Use enhanced processing pipeline
# TRUE_OFFLINE_MODE: Disable ALL external API calls

USE_OPTIMIZED_BACKEND=true
TRUE_OFFLINE_MODE=false

# Google Speech API (when using google-speech-api variant)
USE_GOOGLE_SPEECH_API=false
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ============================================
# 6. VISUAL FEATURES (MediaPipe)
# ============================================
USE_VISUAL_AUGMENTATION=true
MEDIAPIPE_MODEL_COMPLEXITY=0

# ============================================
# 7. FILE SIZE LIMITS
# ============================================
MAX_AUDIO_SIZE_MB=16
MAX_VIDEO_SIZE_MB=50

# ============================================
# 8. TRANSLATION SETTINGS
# ============================================
TRANSLATION_NUM_BEAMS=5
TRANSLATION_MAX_LENGTH=256

# ============================================
# 9. STORAGE PATHS
# ============================================
UPLOAD_FOLDER=./uploads
TEMP_FOLDER=./temp
MODEL_CACHE_DIR=./models

# ============================================
# 10. LOGGING & DEBUG
# ============================================
FLASK_ENV=development
DEBUG_MODE=true
LOG_LEVEL=INFO

# ============================================
# QUICK PRESETS
# ============================================
#
# === M1/M2 Mac (8GB RAM) ===
# WHISPER_MODEL_VARIANT=whisper-medium-sundanese
# WHISPER_MODEL_TYPE=base
# NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
# WHISPER_DEVICE=cpu
# NLLB_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=float32
# ENABLE_GPU_ACCELERATION=false
# FP16_PRECISION=false
# MEDIAPIPE_MODEL_COMPLEXITY=0
#
# === NVIDIA GPU (8GB+ VRAM) ===
# WHISPER_MODEL_VARIANT=whisper-medium-sundanese
# WHISPER_MODEL_TYPE=medium
# NLLB_MODEL_NAME=facebook/nllb-200-1.3B
# WHISPER_DEVICE=cuda
# NLLB_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16
# ENABLE_GPU_ACCELERATION=true
# FP16_PRECISION=true
# MEDIAPIPE_MODEL_COMPLEXITY=1
#
# === CPU Only (Low RAM) ===
# WHISPER_MODEL_VARIANT=whisper-base-1500steps
# WHISPER_MODEL_TYPE=tiny
# NLLB_MODEL_NAME=facebook/nllb-200-distilled-600M
# WHISPER_DEVICE=cpu
# NLLB_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=float32
# ENABLE_GPU_ACCELERATION=false
# FP16_PRECISION=false
# MEDIAPIPE_MODEL_COMPLEXITY=0
