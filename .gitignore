# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
venv/
.venv/

# Environment files (ignore actual env, but keep examples)
.env
.env.local
.env.production
.env.development
backend/.env
backend/.env.local
backend/.env.production
frontend/.env.local
frontend/.env.production

# BUT keep .env.example files (they're templates, should be committed)
!.env.example
!*.env.example
!backend/.env.example
!frontend/.env.example

backend/src/__pycache__/

# Database files
*.db
*.sqlite
*.sqlite3
backend/instance/
instance/

