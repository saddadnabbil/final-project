frontend/out/

# Model files and checkpoints (Hugging Face)
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.pickle
*.model
*.task

# Large model directories (exclude from git but keep structure for docs)
models/**/*
backend/models/**/*
kaggle_output/**/*
!models/.gitkeep
!models/README.md
!backend/models/.gitkeep
!backend/models/README.md
checkpoints/**/*
!checkpoints/.gitkeep
!checkpoints/README.md

# Training outputs and logs (exclude except final results for documentation)
backend/training/data/
backend/training/packaged/
backend/training/outputs/
backend/training/logs/
runs/
tensorboard_logs/
wandb/
.wandb/

# BUT keep important training documentation
!backend/training/*.md
!backend/training/README.md
!backend/training/final_results/
!*/README.md

# Dataset files (large data)
backend/dataset/**/*.wav
backend/dataset/**/*.mp3
backend/dataset/**/*.flac
backend/dataset/**/*.m4a
backend/dataset/**/*.webm
backend/dataset/openslr36/
backend/dataset/openslr36_zips/
kaggle_dataset/**/*.wav
kaggle_dataset/**/*.mp3
kaggle_dataset/**/*.flac
kaggle_dataset/**/*.m4a

# BUT keep dataset manifests and documentation
!**/*.json
!**/*.txt
!**/*.tsv
!**/*.csv
!**/README.md
!**/dataset-metadata.json

# Large compressed files
*.csv
*.tsv
*.json.gz
*.tar.gz
*.zip
*.rar
*.7z
dataset.zip
kaggle_dataset.zip

# BUT keep small documentation files
!docs/**/*.zip
!scripts/**/*.zip
!notebooks/**/*.zip

# Backups
backups/

# Logs
logs/
*.log

# Cloudflare Tunnel credentials (NEVER COMMIT!)
.cloudflared/*.json

# Temporary files and outputs
nul
*.tmp
*.temp
temp/
temp_audio/
uploads/**/*
!uploads/.gitkeep
!uploads/README.md

